# Copy to .env and edit. The Makefile loads it automatically.

# PlanIt asks for a descriptive User-Agent. Put your repo URL or contact address in it.
PLOTCHECK_USER_AGENT="PlotCheck/0.1 (+https://github.com/chanoch01/plotcheck)"

# Where raw API responses land. A local folder, or Azure Blob Storage:
#   abfs://landing@<storage-account>.dfs.core.windows.net
PLOTCHECK_LANDING_URL=data/landing
# AZURE_STORAGE_CONNECTION_STRING=...   # needed only for abfs://

# Warehouse (matches docker-compose.yml)
DESTINATION__POSTGRES__CREDENTIALS=postgresql://plotcheck:plotcheck@localhost:5432/plotcheck
PGHOST=localhost
PGPORT=5432
PGUSER=plotcheck
PGPASSWORD=plotcheck
PGDATABASE=plotcheck
